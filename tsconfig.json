{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // Pinned so @types/bun is not auto-included here. Its global `fetch` carries a
    // `preconnect` property that the DOM's does not, which breaks lib/hono.ts's
    // `typeof fetch` annotation. Bun's types are scoped to tests/tsconfig.json instead.
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // tests/ is type-checked separately (tests/tsconfig.json) so it can pull in Bun's
  // globals without leaking them into the app build.
  "exclude": ["node_modules", "tests"]
}
